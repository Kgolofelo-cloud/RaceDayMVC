@model RacedayMVC.Models.CreateCategoryViewModel
@{
    ViewData["Title"] = "Add Race Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Add Category to Event</h4>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="AddCategory" method="post">
                    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                    <input type="hidden" asp-for="EventID" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-bold">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g., Half Marathon, 10k Fun Run" />
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                            <input asp-for="Distance" type="number" step="0.1" class="form-control" placeholder="21.1" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EntryFee" class="form-label fw-bold">Entry Fee (R)</label>
                            <input asp-for="EntryFee" type="number" step="0.01" class="form-control" placeholder="150.00" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold">Save Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>