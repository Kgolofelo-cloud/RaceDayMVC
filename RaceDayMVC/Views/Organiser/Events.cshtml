@model IEnumerable<RacedayMVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Race Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success fw-bold">+ Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(item.BannerUrl))
                {
                    <img src="@item.BannerUrl" class="card-img-top" alt="Event Banner" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span>No Banner Uploaded</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">@item.EventName</h5>
                    <p class="card-text">
                        <strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")<br />
                        <strong>Location:</strong> @item.Location
                    </p>
                </div>
            </div>
        </div>
    }
</div>