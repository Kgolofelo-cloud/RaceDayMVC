@model IEnumerable<RacedayMVC.Models.EventParticipantViewModel>
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Enrolments: <span class="text-primary">@ViewBag.EventName</span></h2>
    <a asp-action="Events" class="btn btn-secondary">Back to Events</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

<div class="table-responsive shadow-sm rounded bg-white p-3">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Participant</th>
                <th>Category</th>
                <th>Enrolled Date</th>
                <th>Status / Result</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">No participants have enrolled yet.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.ParticipantName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.RegistrationDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.HasResult)
                        {
                            <span class="badge bg-success fs-6">Finished</span>
                            <div class="text-muted small mt-1">
                                Time: <strong>@item.FinishTime</strong> | Pos: <strong>#@item.Position</strong>
                            </div>
                        }
                        else
                        {
                            <form asp-action="PublishResult" method="post" class="d-flex gap-2">
                                <input type="hidden" name="eventId" value="@ViewBag.EventID" />
                                <input type="hidden" name="eventName" value="@ViewBag.EventName" />
                                <input type="hidden" name="registrationId" value="@item.RegistrationID" />
                                <input type="text" name="finishTime" class="form-control form-control-sm" placeholder="HH:MM:SS" required pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}" title="Format: HH:MM:SS" style="width: 100px;" />
                                <input type="number" name="position" class="form-control form-control-sm" placeholder="Pos" required min="1" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-primary fw-bold">Publish</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>