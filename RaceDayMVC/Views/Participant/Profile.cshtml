@model RacedayMVC.Models.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mb-4">My Profile</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold shadow-sm">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold shadow-sm">@TempData["Error"]</div>
}

<div class="row">
    <!-- Left Column: Picture Upload -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 text-center p-4">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="rounded-circle mx-auto mb-3" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #0d6efd;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 150px; height: 150px; font-size: 3rem;">
                    @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                </div>
            }
            <h5 class="fw-bold">@Model.FirstName @Model.LastName</h5>
            <p class="text-muted small mb-4">Athlete</p>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input asp-for="ProfileImage" type="file" class="form-control form-control-sm" accept="image/*" required />
                </div>
                <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-bold">Upload New Picture</button>
            </form>
        </div>
    </div>

    <!-- Right Column: Personal Information -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Personal Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">First Name</div>
                    <div class="col-sm-8 fw-bold">@Model.FirstName</div>
                </div>
                <hr />
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">Last Name</div>
                    <div class="col-sm-8 fw-bold">@Model.LastName</div>
                </div>
                <hr />
                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold text-muted">Email Address</div>
                    <div class="col-sm-8 fw-bold">@Model.Email</div>
                </div>
            </div>
        </div>
    </div>
</div>